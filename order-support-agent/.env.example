# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_BACKEND=anthropic

# Optional: price per 1M tokens in INR, used by evals to estimate cost per chat
INPUT_PRICE_INR_PER_M=0
OUTPUT_PRICE_INR_PER_M=0

# Optional: real Shopify store (otherwise data/orders.json is used)
SHOPIFY_STORE=
SHOPIFY_TOKEN=

# Optional: WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=choose-any-string
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
